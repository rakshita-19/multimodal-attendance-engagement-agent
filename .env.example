# Server configuration
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000
HOST=127.0.0.1
DEBUG=True

# Storage paths
DATABASE_PATH=multimodal_classroom.db
UPLOAD_FOLDER=uploads
TEMP_FOLDER=temp
MAX_CONTENT_LENGTH=104857600 # 100MB in bytes

# Detection & Tracking Config
MIN_PRESENCE_SECONDS=10.0 # Time visible before counting as sustained presence
TRACK_MAX_DISAPPEARED_FRAMES=30 # Number of frames to keep a track before dropping
DETECTION_CONFIDENCE_THRESHOLD=0.35

# Audio Config
AUDIO_ENERGY_THRESHOLD=0.015
AUDIO_SPEECH_LOW_HZ=300
AUDIO_SPEECH_HIGH_HZ=3400
WINDOW_SIZE_SECONDS=5.0 # Multimodal alignment window duration
